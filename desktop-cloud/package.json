{
  "name": "fitma-tick-cloud",
  "productName": "Fitma Tick",
  "version": "0.1.0",
  "description": "Fitma Tick — time and activity tracker (cloud edition for companies).",
  "author": "Fitma",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "lk.fitma.tick.cloud",
    "productName": "Fitma Tick",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "!**/*.map"],
    "win": {
      "target": ["nsis"],
      "icon": "src/assets/icon.ico",
      "artifactName": "Fitma-Tick-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "shortcutName": "Fitma Tick",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "src/assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Fitma-Tick.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "src/assets/icon.png",
      "category": "Utility",
      "artifactName": "Fitma-Tick.${ext}"
    }
  }
}
